<Window x:Class="AudioPlayer.SilenceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioPlayer"
        Title="设置" PreviewKeyDown="Window_PreviewKeyDown"
        Width="480" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI"
        FontSize="12">
    <Window.Resources>
        <Style x:Key="RoundedInput" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Local styles: the audio controls and all other windows retain their existing templates. -->
        <Style x:Key="SettingsTab" TargetType="TabItem">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Foreground" Value="#59636E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="Transparent" CornerRadius="6" Margin="2,0,2,4"/>
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="Indicator" Width="28" Height="3" CornerRadius="1.5" Background="Transparent"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="#E8EDF2"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#26798A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Indicator" Property="Background" Value="#26798A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="Background" Value="#E2E8EF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Outline" CornerRadius="6" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1">
                                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#64748B" StrokeThickness="1.2"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#8998A7"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#26798A"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,4,24,4" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="2" Margin="0,2,0,0">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#26798A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorChoices" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="32"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        <Setter Property="ToolTip" Value="{Binding}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Background="Transparent">
                                        <Ellipse x:Name="Swatch" Width="24" Height="24" Fill="{Binding}" StrokeThickness="0"/>
                                        <Path x:Name="Check" Data="M 0,5 L 4,9 L 12,0" Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.82"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.7"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
      <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl x:Name="SettingsTabs" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsTab}">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                <Border Grid.Row="1" Background="#DDE2E9"/>
                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="2" ContentSource="SelectedContent" Margin="0"/>
              </Grid>
            </ControlTemplate>
          </TabControl.Template>
          <TabItem Header="音频设置">
      <Grid Margin="8,12,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="分析帧长度（ms）" VerticalAlignment="Center" Margin="0,0,4,10"/>
        <TextBox Style="{StaticResource RoundedInput}" TextChanged="Field_TextChanged" x:Name="FrameMillisecondsTextBox" Width="80" TextAlignment="Center" VerticalContentAlignment="Center" AllowDrop="False" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="6,4"
                 PreviewTextInput="PositiveIntegerTextBox_PreviewTextInput" DataObject.Pasting="PositiveIntegerTextBox_Pasting"/>

        <TextBlock Grid.Row="1" Text="最短停顿时长（ms）" VerticalAlignment="Center" Margin="0,0,4,10"/>
        <TextBox Style="{StaticResource RoundedInput}" TextChanged="Field_TextChanged" x:Name="MinimumSilenceTextBox" Width="80" TextAlignment="Center" VerticalContentAlignment="Center" AllowDrop="False" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="6,4"
                 PreviewTextInput="PositiveIntegerTextBox_PreviewTextInput" DataObject.Pasting="PositiveIntegerTextBox_Pasting"
                 LostKeyboardFocus="SilenceInput_LostKeyboardFocus"/>

        <TextBlock Grid.Row="2" Text="静音阈值（dBFS）" VerticalAlignment="Center" Margin="0,0,4,10"/>
        <TextBox Style="{StaticResource RoundedInput}" TextChanged="Field_TextChanged" x:Name="SilenceThresholdTextBox" Width="80" TextAlignment="Center" VerticalContentAlignment="Center" AllowDrop="False" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="6,4"
                 PreviewTextInput="SignedIntegerTextBox_PreviewTextInput" DataObject.Pasting="SignedIntegerTextBox_Pasting"/>

        <TextBlock Grid.Row="3" Text="前后跳转容差（ms）" VerticalAlignment="Center" Margin="0,0,4,10"/>
        <TextBox Style="{StaticResource RoundedInput}" TextChanged="Field_TextChanged" x:Name="NavigationToleranceTextBox" Width="80" TextAlignment="Center" VerticalContentAlignment="Center" AllowDrop="False" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="6,4"
                 PreviewTextInput="PositiveIntegerTextBox_PreviewTextInput" DataObject.Pasting="PositiveIntegerTextBox_Pasting"/>

        <TextBlock Grid.Row="4" Text="允许静音时长 (s)" VerticalAlignment="Center" Margin="0,0,4,10"/>
        <TextBox Style="{StaticResource RoundedInput}" TextChanged="Field_TextChanged" x:Name="AllowedSilenceTextBox" Width="80" TextAlignment="Center" VerticalContentAlignment="Center"
                 AllowDrop="False" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="6,4"
                 PreviewTextInput="AllowedSilenceTextBox_PreviewTextInput" DataObject.Pasting="AllowedSilenceTextBox_Pasting"
                 LostKeyboardFocus="SilenceInput_LostKeyboardFocus"/>

        <TextBlock Grid.Row="0" Grid.Column="3" Text="后退步长 (s)" VerticalAlignment="Center" Margin="0,0,4,10"/>
        <TextBox Style="{StaticResource RoundedInput}" TextChanged="Field_TextChanged" x:Name="BackwardStepTextBox" Width="80" MaxLength="2" TextAlignment="Center" VerticalContentAlignment="Center" AllowDrop="False" Grid.Row="0" Grid.Column="4" Margin="0,0,0,10" Padding="6,4"
                 PreviewTextInput="StepTextBox_PreviewTextInput" DataObject.Pasting="StepTextBox_Pasting"/>

        <TextBlock Grid.Row="1" Grid.Column="3" Text="前进步长 (s)" VerticalAlignment="Center" Margin="0,0,4,10"/>
        <TextBox Style="{StaticResource RoundedInput}" TextChanged="Field_TextChanged" x:Name="ForwardStepTextBox" Width="80" MaxLength="2" TextAlignment="Center" VerticalContentAlignment="Center" AllowDrop="False" Grid.Row="1" Grid.Column="4" Margin="0,0,0,10" Padding="6,4"
                 PreviewTextInput="StepTextBox_PreviewTextInput" DataObject.Pasting="StepTextBox_Pasting"/>

        <TextBlock x:Name="HelpText" Grid.Row="5" Grid.ColumnSpan="5" Foreground="#6B7280" TextWrapping="Wrap"
                   VerticalAlignment="Top" Text="允许静音时长只影响裁剪，不影响左右跳转。"/>

        <TextBlock Grid.Row="6" x:Name="ExcludedFolderNamesLabel" Text="需排除的文件夹" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox x:Name="ExcludedFolderNamesTextBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4"
                 Style="{StaticResource RoundedInput}" TextChanged="Field_TextChanged" Padding="6,4"
                 TextAlignment="Left" VerticalContentAlignment="Center" AllowDrop="False"
                 ToolTip="多个文件夹名称用逗号或分号分隔，不区分大小写。"/>

      </Grid>
          </TabItem>
          <TabItem Header="字幕参数">
            <Grid Margin="8,12,8,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/><ColumnDefinition Width="92"/><ColumnDefinition Width="80"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="字体" VerticalAlignment="Center" Margin="0,0,4,10"/>
              <ComboBox x:Name="FontBox" Grid.Column="1" Style="{StaticResource RoundedComboBox}" Margin="0,0,0,10" AutomationProperties.Name="字体"/>
              <TextBlock Grid.Column="3" Text="字号（DIP）" VerticalAlignment="Center" Margin="0,0,4,10"/>
              <ComboBox x:Name="FontSizeBox" Grid.Column="4" Style="{StaticResource RoundedComboBox}" Margin="0,0,0,10" AutomationProperties.Name="字号"/>
              <TextBlock Grid.Row="1" Text="行高" VerticalAlignment="Center" Margin="0,0,4,10"/>
              <ComboBox x:Name="LineHeightBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedComboBox}" Width="80" HorizontalAlignment="Right" Margin="0,0,0,10" AutomationProperties.Name="行高"/>
              <TextBlock Grid.Row="1" Grid.Column="3" Text="段后间距（DIP）" VerticalAlignment="Center" Margin="0,0,4,10"/>
              <ComboBox x:Name="ParagraphAfterBox" Grid.Row="1" Grid.Column="4" Style="{StaticResource RoundedComboBox}" Margin="0,0,0,10" AutomationProperties.Name="段后间距"/>
              <TextBlock Grid.Row="2" Text="首行缩进（em）" VerticalAlignment="Center" Margin="0,0,4,10"/>
              <ComboBox x:Name="IndentBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource RoundedComboBox}" Width="80" HorizontalAlignment="Right" Margin="0,0,0,10" AutomationProperties.Name="首行缩进"/>
              <Border Grid.Row="3" Grid.ColumnSpan="5" Background="#DDE2E9"/>
              <TextBlock Grid.Row="4" Text="正文颜色" VerticalAlignment="Center" Margin="0,10,4,10"/>
              <ListBox x:Name="TextColorBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource ColorChoices}" SelectionChanged="ColorSelection_Changed"
                       Foreground="White" Margin="0,10,0,10" AutomationProperties.Name="正文颜色"/>
              <TextBlock Grid.Row="5" Text="播放颜色" VerticalAlignment="Center" Margin="0,0,4,10"/>
              <ListBox x:Name="PlaybackColorBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource ColorChoices}" SelectionChanged="ColorSelection_Changed"
                       Foreground="White" Margin="0,0,0,10" AutomationProperties.Name="播放颜色"/>
              <TextBlock Grid.Row="6" Text="背景颜色" VerticalAlignment="Center" Margin="0,0,4,10"/>
              <ListBox x:Name="BackgroundColorBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource ColorChoices}" SelectionChanged="ColorSelection_Changed"
                       Background="#E2E6EB" Foreground="#283747" Margin="0,0,0,10" AutomationProperties.Name="背景颜色"/>
            </Grid>
          </TabItem>
        </TabControl>
        <Grid Grid.Row="1" Margin="8,10,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RestoreDefaultsButton" Width="76" Height="32" Padding="4,2" Content="恢复默认" Click="RestoreDefaultsButton_Click"/>
            <Button x:Name="CancelButton" Grid.Column="2" Width="54" Height="32" Padding="4,2" Margin="0,0,10,0" Content="取消" IsCancel="True"/>
            <Button x:Name="OkButton" Grid.Column="3" Width="54" Height="32" Padding="4,2" Content="确定" Click="OkButton_Click"/>
        </Grid>
      </Grid>
      <local:ToastHost x:Name="ToastMessages" MaxWidth="280" Margin="14,0,14,12"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Panel.ZIndex="10"/>
    </Grid>
</Window>
