<Window x:Class="AudioPlayer.ScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="原文" Width="400" MinWidth="200" MinHeight="300"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="#F8F8F6" Closing="Window_Closing">
    <Grid>
        <wv:WebView2 x:Name="Reader" Visibility="Collapsed"/>
        <TextBlock x:Name="Status" Text="正在初始化原文阅读器…" Foreground="#687783" HorizontalAlignment="Center"
                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="16"/>
    </Grid>
</Window>
