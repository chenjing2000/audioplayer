<Window x:Class="AudioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioPlayer"
        Title="AudioPlayer" Icon="ui/main.ico"
        Background="#F5F7FA" FontFamily="Microsoft YaHei UI" FontSize="12"
        MinWidth="520" MinHeight="420"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        Closing="Window_Closing">
    <Grid>
      <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" Style="{StaticResource CircleButtonStyle}" ToolTip="打开文件夹" AutomationProperties.Name="打开文件夹" VerticalAlignment="Center" Click="OpenButton_Click">
                <Image Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Source="{StaticResource OpenFolderIcon}"/>
            </Button>
            <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center" Minimum="0" Maximum="1" IsEnabled="False"
                        Height="36" IsMoveToPointEnabled="True"
                        ValueChanged="ProgressSlider_ValueChanged"
                        LostMouseCapture="ProgressSlider_LostMouseCapture">
                <Slider.RenderTransform>
                    <TranslateTransform Y="10"/>
                </Slider.RenderTransform>
            </Slider>
            <TextBlock x:Name="TimeText" Grid.Column="2" Margin="0,0,16,0" Text="00:00 / 00:00" VerticalAlignment="Center"
                           Foreground="#566477"/>
            <Button x:Name="PlayButton" Grid.Column="3" Style="{StaticResource CircleButtonStyle}" ToolTip="播放" AutomationProperties.Name="播放"
                    VerticalAlignment="Center" Margin="0,0,5,0" IsEnabled="False" Click="PlayButton_Click">
                <Image x:Name="PlayIconImage" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Source="{StaticResource PlayIcon}"/>
            </Button>
            <Button x:Name="StopButton" Grid.Column="4" Style="{StaticResource CircleButtonStyle}" ToolTip="停止" AutomationProperties.Name="停止" IsEnabled="False"
                    VerticalAlignment="Center" Margin="0,0,5,0" Click="StopButton_Click">
                <Image Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Source="{StaticResource StopIcon}"/>
            </Button>
            <Button x:Name="TrimButton" Grid.Column="5" Style="{StaticResource CircleButtonStyle}" IsEnabled="False" ToolTip="压缩长静音" AutomationProperties.Name="压缩长静音"
                    VerticalAlignment="Center" Margin="0,0,5,0" Click="TrimButton_Click">
                <Image Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Source="{StaticResource TrimIcon}"/>
            </Button>
            <Button x:Name="RefreshButton" Grid.Column="6" Style="{StaticResource CircleButtonStyle}" IsEnabled="False"
                    ToolTip="刷新文件列表" AutomationProperties.Name="刷新文件列表" VerticalAlignment="Center"
                    Margin="0,0,5,0" Click="RefreshButton_Click">
                <Image Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"
                       Source="{StaticResource RefreshIcon}"/>
            </Button>
            <Button x:Name="PlaybackModeButton" Grid.Column="7" Style="{StaticResource CircleButtonStyle}"
                    ToolTip="单曲播放" AutomationProperties.Name="播放模式：单曲播放"
                    VerticalAlignment="Center" Margin="0,0,5,0" Click="PlaybackModeButton_Click">
                <Image x:Name="PlaybackModeImage" Width="28" Height="28" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Stretch="Uniform" Source="{StaticResource PlayOneIcon}"/>
            </Button>
            <Button x:Name="ScriptButton" Grid.Column="8" Style="{StaticResource CircleButtonStyle}" ToolTip="显示原文" AutomationProperties.Name="显示原文" VerticalAlignment="Center" Margin="0,0,5,0" Click="ScriptButton_Click">
                <Image Width="28" Height="28" Source="{StaticResource ScriptIcon}"/>
            </Button>
            <Button x:Name="SettingsButton" Grid.Column="9" Style="{StaticResource CircleButtonStyle}"
                    ToolTip="设置" AutomationProperties.Name="设置"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="SettingsButton_Click">
                <Image Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"
                       Source="{StaticResource SettingsIcon}"/>
            </Button>
        </Grid>
        <Border x:Name="PlaylistBorder" Grid.Row="1" CornerRadius="8" BorderBrush="#DCE2EA" BorderThickness="1"
                Background="White" SizeChanged="PlaylistBorder_SizeChanged">
            <DataGrid x:Name="TrackList" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF1F5" Background="White" BorderThickness="0"
                  RowHeight="25" ColumnHeaderHeight="32" AlternationCount="2"
                  MouseDoubleClick="TrackList_MouseDoubleClick" SelectionChanged="TrackList_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource NoFocusVisual}">
                    <Setter Property="Background" Value="#EAF0F6"/>
                    <Setter Property="Padding" Value="12,4"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Resources>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource NoFocusVisual}">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#243447"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="12,0"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                </Style>
                <Style TargetType="DataGridRowHeader">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource NoFocusVisual}">
                    <Setter Property="BorderThickness" Value="0"/>
                    <EventSetter Event="PreviewKeyDown" Handler="TrackRow_PreviewKeyDown"/>
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                                     Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                                     BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                     BorderThickness="1" Padding="8"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <ToolTip.Template>
                                    <ControlTemplate TargetType="ToolTip">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                                CornerRadius="8">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ToolTip.Template>
                                <TextBlock Text="{Binding RowToolTip}" TextWrapping="Wrap" TextTrimming="None" Margin="0"/>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                    <EventSetter Event="ToolTipOpening" Handler="TrackRow_ToolTipOpening"/>
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#F0F0F0"/></Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#E0DFC6"/></DataTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#F2C867"/></Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="播放状态" Width="94">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="PlayingMark" Data="M0,0 L9,5 L0,10 Z" Fill="#243447" Visibility="Collapsed"/>
                                <StackPanel x:Name="PausedMark" Orientation="Horizontal" Visibility="Collapsed">
                                    <Rectangle Width="3" Height="10" Fill="#243447" Margin="0,0,3,0"/>
                                    <Rectangle Width="3" Height="10" Fill="#243447"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter TargetName="PlayingMark" Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter TargetName="PausedMark" Property="Visibility" Value="Visible"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="*" MinWidth="200"/>
                <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="Margin" Value="12,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="所属专辑" Binding="{Binding Album}" Width="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="Margin" Value="12,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            </DataGrid>
        </Border>
      </Grid>
      <local:ToastHost x:Name="ToastMessages" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="20,0,20,20" Panel.ZIndex="10"/>
    </Grid>
</Window>
